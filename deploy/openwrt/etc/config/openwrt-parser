config openwrt_parser 'main'
    option enabled '1'
    option http_port '8080'
    option sqlite_dsn 'file:/var/lib/openwrt-parser/openwrt-parser.sqlite?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)&_pragma=foreign_keys(ON)'
    option collect_seconds '10'
    option dns_log_lines '4000'
    option ignore_vpn_list 'ignoreVpn'
    option ignore_lan_to_vpn_list 'ignoreLanToVpn'
    option ignore_vpn_interface 'wan'
    option ignore_lan_to_vpn_interface 'wan'
    option singbox_config_path '/etc/sing-box/config.json'
    option singbox_apply_command '/usr/libexec/lan-mode-vpn-setup'
