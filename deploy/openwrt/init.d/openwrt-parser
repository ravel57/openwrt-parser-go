#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
    config_load openwrt-parser

    local enabled http_port sqlite_dsn collect_seconds dns_log_lines
    local ignore_vpn_list ignore_lan_to_vpn_list
    local ignore_vpn_interface ignore_lan_to_vpn_interface

    config_get_bool enabled main enabled 1
    [ "$enabled" -eq 1 ] || return 0

    config_get http_port main http_port 8080
    config_get sqlite_dsn main sqlite_dsn 'file:/var/lib/openwrt-parser/openwrt-parser.sqlite?_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)&_pragma=foreign_keys(ON)'
    config_get collect_seconds main collect_seconds 10
    config_get dns_log_lines main dns_log_lines 4000
    config_get ignore_vpn_list main ignore_vpn_list ignoreVpn
    config_get ignore_lan_to_vpn_list main ignore_lan_to_vpn_list ignoreLanToVpn
    config_get ignore_vpn_interface main ignore_vpn_interface wan
    config_get ignore_lan_to_vpn_interface main ignore_lan_to_vpn_interface wan

    mkdir -p /var/lib/openwrt-parser

    procd_open_instance
    procd_set_param command /usr/bin/openwrt-parser
    procd_set_param env \
        APP_HTTP_PORT="$http_port" \
        APP_SQLITE_DSN="$sqlite_dsn" \
        APP_OPENWRT_MODE=local \
        APP_OPENWRT_DHCP_LEASES_PATH=/tmp/dhcp.leases \
        APP_OPENWRT_CONNTRACK_PATH=/proc/net/nf_conntrack \
        APP_OPENWRT_DNS_LOG_LINES="$dns_log_lines" \
        APP_IGNORE_VPN_LIST="$ignore_vpn_list" \
        APP_IGNORE_LAN_TO_VPN_LIST="$ignore_lan_to_vpn_list" \
        APP_IGNORE_VPN_INTERFACE="$ignore_vpn_interface" \
        APP_IGNORE_LAN_TO_VPN_INTERFACE="$ignore_lan_to_vpn_interface" \
        APP_COLLECT_SECONDS="$collect_seconds" \
        APP_STATIC_DIR=/usr/share/openwrt-parser/web
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger openwrt-parser pbr dhcp
}
